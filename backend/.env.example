# Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Postgres connection string. This is the only database variable the app reads.
# Create the database first:  psql -U postgres -c "CREATE DATABASE ticket_analyzer;"
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ticket_analyzer

# Set to "production" to enable SSL on the database connection
NODE_ENV=development